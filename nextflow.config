// =============================================================================
//  ONT Pipeline — nextflow.config
//  Porechop_ABI → Filtlong → Flye → Medaka → Dnaapler → Stats / PhaBOX2 / Pharokka
//
//  Tuned for phage genomes (typical range: 5 kb – 200 kb).
//  Key differences vs. bacterial / metagenomic runs:
//    • No --meta flag (single-genome, not a community)
//    • Small genome size → expect very high coverage (100×–10,000×)
//    • --no_split recommended: chimera splitting on a tiny genome
//      risks fragmenting legitimate long reads
//    • Low memory requirements — phage assembly is fast
// =============================================================================

// ── Default parameters ────────────────────────────────────────────────────────
params {

    // ── Required ──────────────────────────────────────────────────────────────
    input         = null           // Path to input reads (fastq / fastq.gz)
                                   // Glob patterns supported: "data/*.fastq.gz"
    outdir        = "results"      // Top-level output directory

    // ── Porechop_ABI ──────────────────────────────────────────────────────────
    abi           = true           // Enable ab initio adapter discovery (-abi)
    no_split      = true           // !! PHAGE DEFAULT: disable chimera splitting
    discard_middle = false         // Keep all reads by default
    min_split_read_size = 1000     // Minimum size of split reads (if splitting enabled)

    // ── Flye ──────────────────────────────────────────────────────────────────
    read_type     = "nano-raw"     // nano-raw  → R9 / standard quality
                                   // nano-hq   → R10 / SUP-called (Q20+)
                                   // nano-corr → error-corrected reads
                                   // Note: no leading "--"; that is added by the Flye module
    genome_size   = null           // Phage genome size — set this!
                                   // Examples: "50k", "150k", "200k"
    min_length    = 1000           // Filtlong: discard reads shorter than this (bp)
                                   // Must match Flye's hard min-overlap floor (≥1000)
    target_bases  = null           // Filtlong: subsample to this many bases, longest-first
                                   // null = no subsampling (use all reads passing min_length)
                                   // Example: 11000000 = ~100x of a 110 kb phage genome
                                   // Useful when host contamination inflates coverage
    meta          = false          // NOT used for phage — leave false
    iterations    = 1              // Polishing iterations
    min_overlap   = null           // Minimum read overlap; null = Flye auto
    scaffold      = false          // Scaffolding — not needed for phage

    // ── Resources ─────────────────────────────────────────────────────────────
    threads       = 8

    // ── Conda environment full paths ─────────────────────────────────────────
    // Nextflow requires FULL PATHS to activate existing envs (not env names).
    // These are set automatically by run.sh from CONDA_BASE + env names.
    // You can also override on the CLI:
    //   nextflow run main.nf -profile conda \
    //       --porechop_conda /path/to/base \
    //       --flye_conda /path/to/envs/flye
    porechop_conda = null   // full path to env containing porechop_abi
    filtlong_conda = null   // full path to env containing filtlong
    flye_conda     = null   // full path to env containing flye
    stats_conda    = null   // not used: statistics are computed with built-in awk
    medaka_conda   = null   // full path to env containing medaka
    phabox2_conda  = null   // full path to env containing phabox2
    pharokka_conda = null   // full path to env containing pharokka
    dnaapler_conda = null   // full path to env containing dnaapler (same env as pharokka)

    // ── Medaka ────────────────────────────────────────────────────────────────
    medaka_model   = "r1041_e82_400bps_hac_v4.3.0"
                           // Exact match to Dorado model dna_r10.4.1_e8.2_400bps_hac@v4.3.0

    // ── PhaBOX2 ───────────────────────────────────────────────────────────────
    phabox2_db           = null   // path to phabox2 database directory (required)
    phabox2_min_len      = 1000   // minimum contig length
    phabox2_skip_phamer  = "Y"    // skip virus ID (already confirmed phages by assembly)

    // ── Pharokka ──────────────────────────────────────────────────────────────
    pharokka_db    = null         // path to pharokka database directory (required)

    // ── Resource ceilings (raise on larger machines / HPC) ───────────────────
    max_cpus      = 16
    max_memory    = '16.GB'
    max_time      = '48.h'

    // ── Host branch (optional) ────────────────────────────────────────────────
    assemble_host    = false        // assemble + type the host from unmapped reads
    pool_host        = false        // also assemble pooled host reads of all samples
                                    // (only if samples share one host — see 09_host/host_concordance.txt)
    host_genome_size = "5.5m"       // K. pneumoniae ≈ 5.5 Mb
    host_min_reads   = 1000         // skip host assembly below this many host reads
    host_min_depth   = 10           // below this expected depth: assemble anyway, but flag as low depth
    kaptive_k_db     = "kpsc_k"     // Kaptive keyword: kpsc_k / ab_k
    kaptive_o_db     = "kpsc_o"     // Kaptive keyword: kpsc_o / ab_o
    mlst_scheme      = "klebsiella" // null = automatic scheme detection
    host_map_conda   = null         // env with minimap2 + samtools
    kaptive_conda    = null         // env with kaptive (v3)
    mlst_conda       = null         // env with mlst

    // ── Reporting ─────────────────────────────────────────────────────────────
    report_dir    = "${params.outdir}" 
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    // No process may ask for more than the machine offers
    resourceLimits = [ cpus: params.max_cpus as int, memory: params.max_memory, time: params.max_time ]

    cpus   = { params.threads }
    memory = '16.GB'
    time   = '24.h'

    withName: 'FILTLONG' {
        cpus   = 1
        memory = '4.GB'
        time   = '2.h'
    }
    withName: 'PORECHOP_ABI' {
        cpus   = { params.threads }
        memory = '8.GB'
        time   = '12.h'
    }
    withName: 'FLYE' {
        cpus          = { params.threads }
        memory        = { 8.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: 'ASSEMBLY_STATS' {
        cpus   = 1
        memory = '2.GB'
        time   = '1.h'
    }
    withName: 'MEDAKA' {
        cpus          = { params.threads }
        memory        = '16.GB'
        time          = '8.h'
        errorStrategy = 'retry'
        maxRetries    = 1
    }
    withName: 'PHABOX2' {
        cpus   = { params.threads }
        memory = '16.GB'
        time   = '4.h'
    }
    withName: 'PHAROKKA' {
        cpus   = { params.threads }
        memory = '8.GB'
        time   = '4.h'
    }
    withName: 'DNAAPLER' {
        cpus   = { params.threads }
        memory = '4.GB'
        time   = '1.h'
    }
    // Host branch: failures drop that sample without stopping the pipeline
    withName: 'HOST_READS'  { cpus = { params.threads }; memory = '8.GB';  time = '4.h'; errorStrategy = 'ignore' }
    withName: 'HOST_POOL'   { cpus = 1; memory = '2.GB'; time = '1.h' }
    withName: 'HOST_FLYE'   { cpus = { params.threads }; memory = '16.GB'; time = '12.h'; errorStrategy = 'ignore' }
    withName: 'HOST_MEDAKA' { cpus = { params.threads }; memory = '16.GB'; time = '12.h'; errorStrategy = 'ignore' }
    withName: 'KAPTIVE'     { cpus = { params.threads }; memory = '8.GB';  time = '2.h'; errorStrategy = 'ignore' }
    withName: 'MLST'        { cpus = 1; memory = '4.GB'; time = '1.h'; errorStrategy = 'ignore' }
    withName: 'HOST_SUMMARY_ROW|HOST_CONCORDANCE' { cpus = 1; memory = '1.GB'; time = '30.m' }
}

// ── Execution profiles ────────────────────────────────────────────────────────
profiles {

    // Default: tools must be in PATH
    standard {
        process.executor = 'local'
    }

    // ── conda: activate existing envs via their FULL PATH ───────────────────
    // Nextflow REQUIRES full paths for pre-existing envs.
    // Passing an env name makes Nextflow try to CREATE a new env (wrong).
    // Full paths are constructed in run.sh and passed as params.
    conda {
        conda.enabled  = true
        conda.useMamba = true   // mamba is faster; falls back to conda if absent

        process {
            withName: 'PORECHOP_ABI' {
                conda = params.porechop_conda ?: 'bioconda::porechop_abi=0.5.0'   // e.g. /opt/miniconda/base
            }
            withName: 'FILTLONG' {
                conda = params.filtlong_conda ?: 'bioconda::filtlong=0.3.1'   // e.g. /opt/miniconda/base/envs/filtlong
            }
            withName: 'FLYE' {
                conda = params.flye_conda ?: 'bioconda::flye=2.9.6'       // e.g. /opt/miniconda/base/envs/flye
            }
            withName: 'MEDAKA' {
                conda = params.medaka_conda ?: 'bioconda::medaka=2.1.1'
            }
            // pandas pinned < 3: PhaBOX 2.1.13 (PhaGCN) raises TypeError under pandas 3
            withName: 'PHABOX2' {
                conda = params.phabox2_conda ?: 'bioconda::phabox=2.1.13 conda-forge::pandas=2.2'
            }
            withName: 'PHAROKKA' {
                conda = params.pharokka_conda ?: 'bioconda::pharokka=1.10.1'
            }
            withName: 'HOST_READS'  { conda = params.host_map_conda ?: 'bioconda::minimap2=2.28 bioconda::samtools=1.20' }
            withName: 'HOST_FLYE'   { conda = params.flye_conda     ?: 'bioconda::flye=2.9.6' }
            withName: 'HOST_MEDAKA' { conda = params.medaka_conda   ?: 'bioconda::medaka=2.1.1' }
            withName: 'KAPTIVE'     { conda = params.kaptive_conda  ?: 'bioconda::kaptive=3.1.0' }
            withName: 'MLST'        { conda = params.mlst_conda     ?: 'bioconda::mlst=2.33.1' }
            withName: 'DNAAPLER' {
                conda = params.dnaapler_conda ?: 'bioconda::dnaapler=1.4.0'   // dnaapler is bundled with pharokka env
            }
        }
    }

    // ── Docker: containers built on the fly from the bioconda specs above ────
    // (Seqera Wave; needs internet access)
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        wave.enabled      = true
        wave.strategy     = ['conda']
        process {
            withName: 'PORECHOP_ABI'   { conda = 'bioconda::porechop_abi=0.5.0'   }
            withName: 'FILTLONG'       { conda = 'bioconda::filtlong=0.3.1'       }
            withName: 'FLYE'           { conda = 'bioconda::flye=2.9.6'           }
            withName: 'MEDAKA'         { conda = 'bioconda::medaka=2.1.1'         }
            withName: 'PHABOX2'        { conda = 'bioconda::phabox=2.1.13 conda-forge::pandas=2.2'         }
            withName: 'PHAROKKA'       { conda = 'bioconda::pharokka=1.10.1'       }
            withName: 'DNAAPLER'       { conda = 'bioconda::dnaapler=1.4.0'       }
            withName: 'HOST_READS'     { conda = 'bioconda::minimap2=2.28 bioconda::samtools=1.20' }
            withName: 'HOST_FLYE'      { conda = 'bioconda::flye=2.9.6'           }
            withName: 'HOST_MEDAKA'    { conda = 'bioconda::medaka=2.1.1'         }
            withName: 'KAPTIVE'        { conda = 'bioconda::kaptive=3.1.0'     }
            withName: 'MLST'           { conda = 'bioconda::mlst=2.33.1'           }
        }
    }

    // ── SLURM ─────────────────────────────────────────────────────────────────
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        process.clusterOptions = '--account=your_account'
        executor {
            queueSize    = 50
            pollInterval = '30 sec'
        }
    }

    // ── Test (stub run, no data needed) ───────────────────────────────────────
    test {
        params.input       = "${projectDir}/test_data/test_reads.fastq.gz"
        params.genome_size = "50k"
        params.read_type   = "nano-raw"
        params.no_split    = true
        params.threads     = 2
        params.phabox2_db  = "${projectDir}/test_data"   // placeholder for -stub runs
        params.pharokka_db = "${projectDir}/test_data"
        process.resourceLimits = [cpus: 2, memory: '3.GB', time: '1.h']
        params.host_genome_size = "5.5m"
    }
}

// ── Reports ───────────────────────────────────────────────────────────────────
report   { enabled = true; overwrite = true; file = "${params.report_dir}/pipeline_report.html"   }
timeline { enabled = true; overwrite = true; file = "${params.report_dir}/pipeline_timeline.html" }
dag      { enabled = true; overwrite = true; file = "${params.report_dir}/pipeline_dag.html"      }
trace    { enabled = true; overwrite = true; file = "${params.report_dir}/pipeline_trace.txt"
           fields = 'task_id,name,status,exit,realtime,cpus,%cpu,memory,%mem,rss'                }

// ── Manifest ──────────────────────────────────────────────────────────────────
manifest {
    name            = 'phage-assembly-nf'
    author          = 'Abdulmalek T. Algarni'
    homePage        = 'https://github.com/atalgarni/phage-assembly-nf'
    description     = 'ONT phage genome assembly, polishing, reorientation and annotation: Porechop_ABI → Filtlong → Flye → Medaka → Dnaapler → PhaBOX2 / Pharokka'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}
